<UserControl
    x:Class="Hello.World.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="32" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="示例插件"
                   FontSize="26"
                   FontWeight="SemiBold" />

        <TextBlock Grid.Row="1"
                   Text="这个页面来自一个独立编译的插件程序集，它自己的 XAML 与 .pri 资源在运行时被加载。"
                   TextWrapping="Wrap"
                   Opacity="0.72" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="10">
            <Button x:Name="PingButton" Content="测试宿主 API" Click="OnPingClick" />
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Opacity="0.72" />
        </StackPanel>

        <TextBlock Grid.Row="3"
                   TextWrapping="Wrap"
                   Opacity="0.5"
                   VerticalAlignment="Bottom"
                   Text="提示：改动后重新 build 并替换插件包，重启启动器即可看到变化（类型 A 不做热重载）。" />
    </Grid>
</UserControl>
