<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="ColorBg">#FF04060B</Color>
    <Color x:Key="ColorText">#FFF3F7FE</Color>
    <Color x:Key="ColorTextSecondary">#FF91A0B8</Color>
    <Color x:Key="ColorTextTertiary">#FF5E6B81</Color>
    <Color x:Key="ColorMint">#FF7CEBD6</Color>
    <Color x:Key="ColorViolet">#FFA996FF</Color>
    <Color x:Key="ColorSky">#FF61C8FF</Color>
    <Color x:Key="ColorDanger">#FFFF6B8A</Color>
    <Color x:Key="ColorStroke">#24FFFFFF</Color>

    <SolidColorBrush x:Key="BrushBg" Color="{StaticResource ColorBg}" />
    <SolidColorBrush x:Key="BrushText" Color="{StaticResource ColorText}" />
    <SolidColorBrush x:Key="BrushTextSecondary" Color="{StaticResource ColorTextSecondary}" />
    <SolidColorBrush x:Key="BrushTextTertiary" Color="{StaticResource ColorTextTertiary}" />
    <SolidColorBrush x:Key="BrushMint" Color="{StaticResource ColorMint}" />
    <SolidColorBrush x:Key="BrushViolet" Color="{StaticResource ColorViolet}" />
    <SolidColorBrush x:Key="BrushSky" Color="{StaticResource ColorSky}" />
    <SolidColorBrush x:Key="BrushDanger" Color="{StaticResource ColorDanger}" />
    <SolidColorBrush x:Key="BrushStroke" Color="{StaticResource ColorStroke}" />
    <SolidColorBrush x:Key="BrushWarn" Color="#FFFFC078" />
    <SolidColorBrush x:Key="BrushWarnSoft" Color="#33FFB86B" />
    <SolidColorBrush x:Key="BrushSurface" Color="#B30A101B" />
    <SolidColorBrush x:Key="BrushSurfaceRaised" Color="#D00E1624" />
    <SolidColorBrush x:Key="BrushTransparent" Color="Transparent" />
    <SolidColorBrush x:Key="BrushFillSubtle" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="BrushFillSoft" Color="#10FFFFFF" />
    <SolidColorBrush x:Key="BrushBorderSubtle" Color="#1EFFFFFF" />
    <!-- 滑块滑轨：比 BrushFillSubtle 更实一点，浅色玻璃上才看得见那条底线。 -->
    <SolidColorBrush x:Key="BrushSliderTrack" Color="#26FFFFFF" />
    <SolidColorBrush x:Key="BrushField" Color="#0EFFFFFF" />
    <SolidColorBrush x:Key="BrushFieldBorder" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="BrushHover" Color="#18FFFFFF" />
    <SolidColorBrush x:Key="BrushPressed" Color="#24FFFFFF" />
    <SolidColorBrush x:Key="BrushSelected" Color="#2E7CEBD6" />
    <SolidColorBrush x:Key="BrushSelectedHover" Color="#3A7CEBD6" />
    <SolidColorBrush x:Key="BrushOnAccent" Color="#FF061018" />
    <SolidColorBrush x:Key="BrushCardTint" Color="#33162134" />

    <LinearGradientBrush x:Key="BrushAccent" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF7CEBD6" Offset="0" />
        <GradientStop Color="#FF9FE6FF" Offset="0.48" />
        <GradientStop Color="#FFA996FF" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BrushAccentSoft" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#337CEBD6" Offset="0" />
        <GradientStop Color="#1FA996FF" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BrushGlass" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#B3121B2A" Offset="0" />
        <GradientStop Color="#7A0B1220" Offset="0.55" />
        <GradientStop Color="#66080E18" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BrushGlassCard" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#26162134" Offset="0" />
        <GradientStop Color="#1C101A2A" Offset="0.58" />
        <GradientStop Color="#140A101C" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BrushGlassFaint" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#59182638" Offset="0" />
        <GradientStop Color="#330C1320" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BrushGlassRim" StartPoint="0,0" EndPoint="0.7,1">
        <GradientStop Color="#52FFFFFF" Offset="0" />
        <GradientStop Color="#22FFFFFF" Offset="0.32" />
        <GradientStop Color="#0FFFFFFF" Offset="0.72" />
        <GradientStop Color="#08FFFFFF" Offset="1" />
    </LinearGradientBrush>

    <!-- Liquid-glass top gloss: sits above a glass surface as a 1px-ish sheen plus a soft falloff.
         ThemeManager swaps the two stops so it reads as a light catch in dark mode and a
         cool sheen in light mode. -->
    <LinearGradientBrush x:Key="BrushGlassHighlight" StartPoint="0,0" EndPoint="0.35,1">
        <GradientStop Color="#3DFFFFFF" Offset="0" />
        <GradientStop Color="#12FFFFFF" Offset="0.28" />
        <GradientStop Color="#00FFFFFF" Offset="0.62" />
    </LinearGradientBrush>

    <!-- Floating surfaces (menus, popovers, dock) blur what is behind them. -->
    <AcrylicBrush x:Key="BrushGlassLiquid" TintColor="#0A111D" TintOpacity="0.58" FallbackColor="#E60A111D" />

    <Style x:Key="TextBase" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
        <Setter Property="Foreground" Value="{StaticResource BrushText}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="IsTextSelectionEnabled" Value="False" />
    </Style>

    <Style x:Key="TextPageTitle" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
        <Setter Property="FontSize" Value="30" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="-12" />
    </Style>

    <Style x:Key="TextHeroTitle" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
        <Setter Property="FontSize" Value="58" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="-28" />
        <Setter Property="LineHeight" Value="60" />
    </Style>

    <Style x:Key="TextSectionTitle" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
        <Setter Property="FontSize" Value="19" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="TextBody" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
        <Setter Property="LineHeight" Value="21" />
    </Style>

    <Style x:Key="TextSmall" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextTertiary}" />
    </Style>

    <Style x:Key="TextEyebrow" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextTertiary}" />
        <Setter Property="CharacterSpacing" Value="180" />
    </Style>

    <Style x:Key="GlassCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BrushGlassCard}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushGlassRim}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="24" />
        <Setter Property="Padding" Value="24" />
    </Style>

    <Style x:Key="GlassPanel" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BrushGlass}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushGlassRim}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="24" />
    </Style>

    <!-- 圆角方形标签：不再使用 height/2 的胶囊圆角 -->
    <Style x:Key="Pill" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BrushFillSubtle}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorderSubtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12,6" />
    </Style>

    <Style x:Key="AccentButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource BrushAccent}" />
        <Setter Property="Foreground" Value="{StaticResource BrushOnAccent}" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Height" Value="46" />
        <Setter Property="Padding" Value="22,0" />
        <Setter Property="CornerRadius" Value="15" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="GhostButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource BrushFillSubtle}" />
        <Setter Property="Foreground" Value="{StaticResource BrushText}" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Height" Value="46" />
        <Setter Property="Padding" Value="18,0" />
        <Setter Property="CornerRadius" Value="15" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorderSubtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="IconButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource BrushSearchGlass}" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
        <Setter Property="Width" Value="38" />
        <Setter Property="Height" Value="38" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="13" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorderSubtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- 页面级滚动容器：右侧留出滚动条的位置，避免细滚动条压在卡片文字上 -->
    <Style x:Key="PageScroll" TargetType="ScrollViewer">
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="Padding" Value="0,0,12,0" />
        <Setter Property="IsTabStop" Value="False" />
    </Style>

    <!-- 自定义滑块：细轨 + 薄荷填充 + 双层圆点，替掉 WinUI 默认的粗轨大圆点。
         Slider 靠模板部件名定位进度：HorizontalTemplate / HorizontalTrackRect /
         HorizontalDecreaseRect / HorizontalThumb，改名就失效。 -->
    <Style x:Key="MusicSlider" TargetType="Slider">
        <Setter Property="Foreground" Value="{StaticResource BrushMint}" />
        <Setter Property="Background" Value="{StaticResource BrushSliderTrack}" />
        <Setter Property="IsThumbToolTipEnabled" Value="False" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="Height" Value="20" />
        <Setter Property="MinWidth" Value="60" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <!-- 结构必须和 WinUI 默认模板一致：三列（已选 / 滑块 / 剩余），
                         Slider 的代码按列宽算滑块位置、按 HorizontalTrackRect 的宽度算数值。
                         少了这三列，点击与拖动的落点会整体偏移，拖到哪都不准。 -->
                    <Grid Background="Transparent" VerticalAlignment="Center" Height="20">
                        <Grid x:Name="HorizontalTemplate" Height="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <!-- 部件必须用 Rectangle（换成 Border 控件就找不到，已选进度不上色）。 -->
                            <Rectangle x:Name="HorizontalTrackRect" Grid.ColumnSpan="3" Height="4"
                                       RadiusX="2" RadiusY="2" VerticalAlignment="Center"
                                       Fill="{TemplateBinding Background}" />
                            <Rectangle x:Name="HorizontalDecreaseRect" Grid.Column="0" Height="4"
                                       RadiusX="2" RadiusY="2" VerticalAlignment="Center"
                                       Fill="{TemplateBinding Foreground}" />
                            <Thumb x:Name="HorizontalThumb" Grid.Column="1" Width="18" Height="18"
                                   VerticalAlignment="Center" Background="{TemplateBinding Foreground}">
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Grid Width="18" Height="18">
                                            <Ellipse Width="18" Height="18" Opacity="0.22"
                                                     Fill="{TemplateBinding Background}" />
                                            <Ellipse Width="10" Height="10" Fill="{TemplateBinding Background}" />
                                        </Grid>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Grid>
                        <Grid x:Name="VerticalTemplate" Height="20" Visibility="Collapsed" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <LinearGradientBrush x:Key="BrushNavSelected" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#3D7CEBD6" Offset="0" />
        <GradientStop Color="#1FA996FF" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="BrushNavSelectedBorder" Color="#4D7CEBD6" />
    <SolidColorBrush x:Key="BrushNavHover" Color="#14FFFFFF" />

    <Style x:Key="NavButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextTertiary}" />
        <Setter Property="Width" Value="64" />
        <Setter Property="Height" Value="64" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="FocusVisualPrimaryThickness" Value="0" />
        <Setter Property="FocusVisualSecondaryThickness" Value="0" />
    </Style>

    <Style x:Key="FieldBox" TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource BrushField}" />
        <Setter Property="Foreground" Value="{StaticResource BrushText}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushFieldBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="13" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="MinHeight" Value="44" />
    </Style>

    <AcrylicBrush x:Key="BrushSearchGlass" TintColor="#0A111D" TintOpacity="0.58" FallbackColor="#D10A111D" />

    <Style x:Key="SearchField" TargetType="TextBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource BrushText}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="PlaceholderForeground" Value="{StaticResource BrushTextTertiary}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SelectionHighlightColor" Value="#667CEBD6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <ScrollViewer x:Name="ContentElement"
                                      HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Hidden"
                                      Foreground="{TemplateBinding Foreground}"
                                      Background="Transparent"
                                      IsTabStop="False" ZoomMode="Disabled"
                                      AutomationProperties.AccessibilityView="Raw" />
                        <TextBlock x:Name="PlaceholderTextContentPresenter"
                                   Text="{TemplateBinding PlaceholderText}"
                                   Foreground="{TemplateBinding PlaceholderForeground}"
                                   FontSize="{TemplateBinding FontSize}"
                                   IsHitTestVisible="False"
                                   VerticalAlignment="Center" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <AcrylicBrush x:Key="ComboBoxDropDownBackground" TintColor="#0A111E" TintOpacity="0.72" FallbackColor="#F20A111E" />
    <AcrylicBrush x:Key="MenuFlyoutPresenterBackground" TintColor="#0A111E" TintOpacity="0.80" FallbackColor="#F20A111E" />
    <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="#2EFFFFFF" />
    <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPointerOver" Color="#18FFFFFF" />
    <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPressed" Color="#24FFFFFF" />
    <SolidColorBrush x:Key="MenuFlyoutItemForeground" Color="{StaticResource ColorText}" />
    <SolidColorBrush x:Key="MenuFlyoutItemForegroundPointerOver" Color="{StaticResource ColorText}" />
    <CornerRadius x:Key="OverlayCornerRadius">16</CornerRadius>
    <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#2EFFFFFF" />
    <SolidColorBrush x:Key="ComboBoxBackground" Color="#12FFFFFF" />
    <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#1CFFFFFF" />
    <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#24FFFFFF" />
    <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#38FFFFFF" />
    <SolidColorBrush x:Key="ComboBoxForeground" Color="{StaticResource ColorText}" />
    <SolidColorBrush x:Key="ComboBoxForegroundPointerOver" Color="{StaticResource ColorText}" />
    <SolidColorBrush x:Key="ComboBoxItemBackgroundPointerOver" Color="#18FFFFFF" />
    <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="#2E7CEBD6" />
    <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPointerOver" Color="#3A7CEBD6" />
    <SolidColorBrush x:Key="ComboBoxItemForegroundSelected" Color="{StaticResource ColorText}" />
    <SolidColorBrush x:Key="ComboBoxItemPillFillBrush" Color="{StaticResource ColorMint}" />
    <SolidColorBrush x:Key="ComboBoxDropDownForeground" Color="{StaticResource ColorText}" />

    <Style x:Key="NavIcon" TargetType="Path">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Stretch" Value="None" />
        <Setter Property="Stroke" Value="{StaticResource BrushTextSecondary}" />
        <Setter Property="StrokeThickness" Value="1.9" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="StrokeLineJoin" Value="Round" />
        <Setter Property="Fill" Value="Transparent" />
    </Style>

</ResourceDictionary>