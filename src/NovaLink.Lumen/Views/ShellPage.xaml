<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="NovaLink.Lumen.Views.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:NovaLink.Lumen.Controls"
    mc:Ignorable="d"
    Background="Transparent"
    AllowDrop="True"
    DragOver="Root_DragOver"
    Drop="Root_Drop">

    <Grid x:Name="RootShell" PointerMoved="Shell_PointerMoved" PointerExited="Shell_PointerExited">
        <Grid x:Name="Backdrop" IsHitTestVisible="False">
            <Rectangle Fill="{StaticResource BrushBg}" />
            <controls:AuroraBackdrop x:Name="Aurora" />
            <Image x:Name="CustomBackgroundImage" Stretch="UniformToFill" Visibility="Collapsed">
                <Image.RenderTransform>
                    <CompositeTransform x:Name="CustomImageTransform" CenterX="0" CenterY="0" />
                </Image.RenderTransform>
            </Image>
            <MediaPlayerElement x:Name="CustomBackgroundVideo" Stretch="UniformToFill" Visibility="Collapsed"
                                AreTransportControlsEnabled="False">
                <MediaPlayerElement.RenderTransform>
                    <CompositeTransform x:Name="CustomVideoTransform" CenterX="0" CenterY="0" />
                </MediaPlayerElement.RenderTransform>
            </MediaPlayerElement>
            <Rectangle x:Name="CustomBackgroundVeil" Fill="#B3050A12" Visibility="Collapsed" />
            <Rectangle x:Name="BackdropTint" Fill="#18040A12" />
        </Grid>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="86" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border x:Name="NavRail" Grid.Column="0" Background="#38060B13" BorderBrush="#12FFFFFF" BorderThickness="0,0,1,0">
                <Grid Padding="0,18,0,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Image x:Name="BrandLogo" Width="46" Height="46" HorizontalAlignment="Center"
                           Source="ms-appx:///Assets/Images/lumen-logo.svg" />

                    <StackPanel Grid.Row="1" Spacing="6" Margin="0,32,0,0">
                        <Button x:Name="NavHome" AutomationProperties.AutomationId="NavHome" Tag="home" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource NavButton}" Click="Nav_Click">
                            <Grid Width="64" Height="64" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path Margin="0,0,0,6" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource NavIcon}" Data="M3 10.5 12 3l9 7.5V21a1 1 0 0 1-1 1h-5v-7H9v7H4a1 1 0 0 1-1-1z" />
                                    <TextBlock Text="首页" FontSize="10" FontWeight="SemiBold" LineHeight="12" LineStackingStrategy="BlockLineHeight" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Margin="0" Padding="0" />
                                </StackPanel>
                            </Grid>
                        </Button>
                        <Button x:Name="NavVersions" AutomationProperties.AutomationId="NavVersions" Tag="versions" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource NavButton}" Click="Nav_Click">
                            <Grid Width="64" Height="64" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path Margin="0,0,0,6" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource NavIcon}" Data="M12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83zM22 17.65l-9.17 4.16a2 2 0 0 1-1.66 0L2 17.65M22 12.65l-9.17 4.16a2 2 0 0 1-1.66 0L2 12.65" />
                                    <TextBlock Text="版本" FontSize="10" FontWeight="SemiBold" LineHeight="12" LineStackingStrategy="BlockLineHeight" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Margin="0" Padding="0" />
                                </StackPanel>
                            </Grid>
                        </Button>
                        <Button x:Name="NavDiscover" AutomationProperties.AutomationId="NavDiscover" Tag="discover" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource NavButton}" Click="Nav_Click">
                            <Grid Width="64" Height="64" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path Margin="0,0,0,6" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource NavIcon}" Data="M12 2a10 10 0 1 0 0 20a10 10 0 1 0 0-20zM16.24 7.76l-2.12 6.36l-6.36 2.12l2.12-6.36z" />
                                    <TextBlock Text="发现" FontSize="10" FontWeight="SemiBold" LineHeight="12" LineStackingStrategy="BlockLineHeight" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Margin="0" Padding="0" />
                                </StackPanel>
                            </Grid>
                        </Button>
                        <Button x:Name="NavForum" AutomationProperties.AutomationId="NavForum" Tag="forum" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource NavButton}" Click="Nav_Click">
                            <Grid Width="64" Height="64" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path Margin="0,0,0,6" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource NavIcon}" Data="M7.9 20A9 9 0 1 0 4 16.1L2 22z" />
                                    <TextBlock Text="论坛" FontSize="10" FontWeight="SemiBold" LineHeight="12" LineStackingStrategy="BlockLineHeight" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Margin="0" Padding="0" />
                                </StackPanel>
                            </Grid>
                        </Button>
                        <Button x:Name="NavLibrary" AutomationProperties.AutomationId="NavLibrary" Tag="library" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource NavButton}" Click="Nav_Click">
                            <Grid Width="64" Height="64" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path Margin="0,0,0,6" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource NavIcon}" Data="M4 4v16M8 4v16M12 4v16M16 6l4 14" />
                                    <TextBlock Text="库" FontSize="10" FontWeight="SemiBold" LineHeight="12" LineStackingStrategy="BlockLineHeight" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Margin="0" Padding="0" />
                                </StackPanel>
                            </Grid>
                        </Button>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Spacing="10">
                        <Button x:Name="NavSettings" AutomationProperties.AutomationId="NavSettings" Tag="settings" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource NavButton}" Click="Nav_Click">
                            <Grid Width="64" Height="64" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path Margin="0,0,0,6" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource NavIcon}" Data="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2zM12 15a3 3 0 1 0 0-6a3 3 0 0 0 0 6z" />
                                    <TextBlock Text="设置" FontSize="10" FontWeight="SemiBold" LineHeight="12" LineStackingStrategy="BlockLineHeight" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Margin="0" Padding="0" />
                                </StackPanel>
                            </Grid>
                        </Button>
                        <Grid Width="64" HorizontalAlignment="Center">
                            <Border x:Name="VersionChip" Height="24" Padding="9,0" CornerRadius="7" HorizontalAlignment="Center"
                                    Background="#12FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <Grid Width="8" Height="8">
                                        <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#337CEBD6" />
                                        <Ellipse Width="4" Height="4" Fill="{StaticResource BrushMint}"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                    <TextBlock Text="1.4.0" FontSize="9.5" Foreground="{StaticResource BrushTextTertiary}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Column="1">
                <!-- 内容一直铺到窗口底边并延伸到顶栏后面，顶栏只靠磨砂控件遮罩，不做整条渐变限位。 -->
                <Frame x:Name="ContentFrame" Margin="30,0,30,0" Background="Transparent" />

                <Grid Height="68" Margin="30,6,30,0" VerticalAlignment="Top">
                    <Border x:Name="SearchShell" Width="372" Height="42" HorizontalAlignment="Center" VerticalAlignment="Center"
                            CornerRadius="15" Background="{StaticResource BrushSearchGlass}" BorderBrush="#40FFFFFF" BorderThickness="1">
                        <Grid>
                            <Border Height="1" Margin="18,0,18,0" VerticalAlignment="Top" CornerRadius="1" IsHitTestVisible="False">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#00FFFFFF" Offset="0" />
                                        <GradientStop Color="#3DFFFFFF" Offset="0.42" />
                                        <GradientStop Color="#00FFFFFF" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <Grid Margin="14,0,13,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Path Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center"
                                      Stroke="{StaticResource BrushTextTertiary}" StrokeThickness="1.8"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Data="M11 19a8 8 0 1 0 0-16a8 8 0 0 0 0 16zM21 21l-4.35-4.35" />
                                <TextBox x:Name="SearchBox" Grid.Column="1" Margin="10,0,0,0"
                                         Style="{StaticResource SearchField}"
                                         PlaceholderText="搜索实例、版本或操作" VerticalAlignment="Center"
                                         KeyDown="SearchBox_KeyDown" GotFocus="SearchBox_GotFocus" LostFocus="SearchBox_LostFocus" />
                                <Border x:Name="SearchShortcut" Grid.Column="2" CornerRadius="7" Background="#18FFFFFF" Padding="6,2"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="Ctrl K" FontSize="9.5" Foreground="{StaticResource BrushTextTertiary}" />
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>

                    <StackPanel Orientation="Horizontal" Spacing="9" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Border x:Name="GameStatusChip" Height="40" Padding="12,0" CornerRadius="13"
                                Background="#2A0E2A22" BorderBrush="#557CEBD6" BorderThickness="1"
                                Visibility="Collapsed" Tapped="GameStatusChip_Tapped">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Ellipse Width="7" Height="7" Fill="{StaticResource BrushMint}" />
                                <TextBlock x:Name="GameStatusText" Text="游戏运行中" FontSize="11.5"
                                           FontWeight="SemiBold" Foreground="{StaticResource BrushMint}" />
                                <TextBlock x:Name="GameInstanceText" Text="" FontSize="10.5"
                                           Foreground="{StaticResource BrushTextTertiary}" MaxWidth="130"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                        <Button x:Name="GameStopButton" Height="40" Padding="15,0" CornerRadius="13"
                                Background="#26FF6B6B" BorderBrush="#44FF8A8A" BorderThickness="1"
                                Foreground="#FFFFC0C0" Visibility="Collapsed" Click="GameStop_Click">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <FontIcon Glyph="&#xE71A;" FontSize="12" />
                                <TextBlock Text="关闭游戏" FontSize="11.5" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                        <Border x:Name="JavaChip" Style="{StaticResource Pill}" Height="40" Padding="13,0"
                                Background="{StaticResource BrushSearchGlass}" BorderBrush="#2EFFFFFF">
                            <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE943;" FontSize="13" Foreground="{StaticResource BrushMint}" />
                                <TextBlock x:Name="JavaChipText" Text="Java" FontSize="11.5"
                                           Foreground="{StaticResource BrushTextSecondary}" />
                            </StackPanel>
                        </Border>
                        <Button Style="{StaticResource IconButton}" Click="Activity_Click">
                            <FontIcon Glyph="&#xE9D9;" FontSize="15" />
                        </Button>
                        <Button Style="{StaticResource IconButton}" Click="Bell_Click">
                            <FontIcon Glyph="&#xE7E7;" FontSize="15" />
                        </Button>
                        <Button x:Name="AccountButton" Height="44" Padding="8,0,11,0" CornerRadius="15"
                                Background="{StaticResource BrushSearchGlass}" BorderBrush="#40FFFFFF" BorderThickness="1"
                                HorizontalContentAlignment="Left" Click="Account_Click">
                            <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                                <Grid Width="29" Height="29">
                                    <Border x:Name="AccountAvatarFallback" CornerRadius="9" Background="{StaticResource BrushAccentSoft}">
                                        <TextBlock x:Name="AccountInitial" Text="N" FontSize="12" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <Border CornerRadius="9" Background="Transparent">
                                        <Image x:Name="AccountAvatar" Stretch="UniformToFill" ImageFailed="AccountAvatar_ImageFailed" />
                                    </Border>
                                </Grid>
                                <StackPanel VerticalAlignment="Center" Spacing="0">
                                    <TextBlock x:Name="AccountName" Text="未登录" FontSize="12" FontWeight="SemiBold" />
                                    <TextBlock x:Name="AccountSubtitle" Text="离线账户" FontSize="9.5"
                                               Foreground="{StaticResource BrushTextTertiary}" />
                                </StackPanel>
                                <FontIcon Glyph="&#xE70D;" FontSize="10" Foreground="{StaticResource BrushTextTertiary}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>

        <Border x:Name="MusicDock" Width="352" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Margin="86,0,0,22" Padding="10,8" CornerRadius="15"
                Background="{StaticResource BrushSearchGlass}" BorderBrush="{StaticResource BrushBorderSubtle}"
                BorderThickness="1" Visibility="Collapsed">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="30" Height="30" CornerRadius="9" Background="{StaticResource BrushAccentSoft}">
                    <FontIcon Glyph="&#xE8D6;" FontSize="13" Foreground="{StaticResource BrushMint}" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="0">
                    <TextBlock x:Name="MusicTitle" Text="未选择音乐" FontSize="11.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="MusicSubtitle" Text="在设置中导入音乐" FontSize="9" Foreground="{StaticResource BrushTextTertiary}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Button x:Name="MusicModeButton" Grid.Column="2" Width="28" Height="28" Padding="0" CornerRadius="8"
                        Style="{StaticResource GhostButton}" Click="MusicMode_Click" ToolTipService.ToolTip="播放方式">
                    <FontIcon x:Name="MusicModeIcon" Glyph="&#xE8EE;" FontSize="12" />
                </Button>
                <Button Grid.Column="3" Width="28" Height="28" Padding="0" CornerRadius="8"
                        Style="{StaticResource GhostButton}" Click="MusicPrevious_Click" ToolTipService.ToolTip="上一首">
                    <FontIcon Glyph="&#xE892;" FontSize="12" />
                </Button>
                <Button Grid.Column="4" Width="30" Height="30" Padding="0" CornerRadius="9"
                        Style="{StaticResource AccentButton}" Click="MusicToggle_Click" ToolTipService.ToolTip="播放 / 暂停">
                    <FontIcon x:Name="MusicPlayIcon" Glyph="&#xE768;" FontSize="12" />
                </Button>
                <Button Grid.Column="5" Width="28" Height="28" Padding="0" CornerRadius="8"
                        Style="{StaticResource GhostButton}" Click="MusicNext_Click" ToolTipService.ToolTip="下一首">
                    <FontIcon Glyph="&#xE893;" FontSize="12" />
                </Button>
            </Grid>
        </Border>

        <Border x:Name="ProgressDock" Width="326" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,28,24" Padding="14,12" CornerRadius="16"
                Background="#F20A1220" BorderBrush="#33FFFFFF" BorderThickness="1"
                Visibility="Collapsed" Tapped="ProgressDock_Tapped">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="26" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="26" Height="26" CornerRadius="8" Background="#207CEBD6">
                        <FontIcon x:Name="ProgressDockIcon" Glyph="&#xE896;" FontSize="12"
                                  Foreground="{StaticResource BrushMint}" />
                    </Border>
                    <TextBlock x:Name="ProgressDockTitle" Grid.Column="1" FontSize="12" FontWeight="SemiBold"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <Border x:Name="ProgressDockMore" Grid.Column="2" CornerRadius="7" Padding="6,1"
                            Background="#1CFFFFFF" Visibility="Collapsed">
                        <TextBlock x:Name="ProgressDockMoreText" FontSize="9" Foreground="{StaticResource BrushTextSecondary}" />
                    </Border>
                    <TextBlock x:Name="ProgressDockPercent" Grid.Column="3" FontSize="11.5" FontWeight="SemiBold"
                               VerticalAlignment="Center" Foreground="{StaticResource BrushMint}" />
                </Grid>
                <ProgressBar x:Name="ProgressDockBar" Grid.Row="1" Height="4" CornerRadius="2"
                             Foreground="{StaticResource BrushMint}" Background="#18FFFFFF" />
                <Grid Grid.Row="2" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ProgressDockStatus" FontSize="9.5" Foreground="{StaticResource BrushTextTertiary}" />
                    <TextBlock x:Name="ProgressDockMessage" Grid.Column="1" FontSize="9.5"
                               Foreground="{StaticResource BrushTextTertiary}" TextTrimming="CharacterEllipsis"
                               HorizontalAlignment="Right" />
                </Grid>
            </Grid>
        </Border>

        <Grid x:Name="RootSwitchLayer" Visibility="Collapsed" Opacity="0" Background="#B804080E"
              IsHitTestVisible="True">
            <Border x:Name="RootSwitchCard" Width="470" Padding="26,24" CornerRadius="22"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{StaticResource BrushSearchGlass}" BorderBrush="{StaticResource BrushBorderSubtle}"
                    BorderThickness="1">
                <StackPanel Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <Grid Width="52" Height="52" VerticalAlignment="Center">
                            <Ellipse Width="52" Height="52" Stroke="#24FFFFFF" StrokeThickness="2" />
                            <Path x:Name="RootSwitchArc" Data="M26,2 A24,24 0 0 1 50,26"
                                  Stroke="{StaticResource BrushMint}" StrokeThickness="2.6"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform>
                                    <RotateTransform x:Name="RootSwitchRotate" Angle="0" />
                                </Path.RenderTransform>
                            </Path>
                            <FontIcon Glyph="&#xE8B7;" FontSize="18" Foreground="{StaticResource BrushText}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <StackPanel VerticalAlignment="Center" Spacing="3">
                            <TextBlock Text="正在切换游戏目录" FontSize="16.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource BrushText}" />
                            <TextBlock Text="版本、模组、资源包、光影与世界会一起切换。"
                                       FontSize="11" Foreground="{StaticResource BrushTextSecondary}" />
                        </StackPanel>
                    </StackPanel>

                    <Border Background="{StaticResource BrushFillSubtle}" BorderBrush="{StaticResource BrushBorderSubtle}"
                            BorderThickness="1" CornerRadius="13" Padding="13,10">
                        <StackPanel Spacing="3">
                            <TextBlock Text=".minecraft" FontSize="9.5" CharacterSpacing="110"
                                       Foreground="{StaticResource BrushTextTertiary}" />
                            <TextBlock x:Name="RootSwitchPath" FontSize="11.5" FontFamily="Cascadia Mono"
                                       Foreground="{StaticResource BrushTextSecondary}"
                                       TextTrimming="CharacterEllipsis" MaxLines="2" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="RootSwitchStatus" Text="正在写入游戏目录…" FontSize="11"
                               Foreground="{StaticResource BrushMint}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
