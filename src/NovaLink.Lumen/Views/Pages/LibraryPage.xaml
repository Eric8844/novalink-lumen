<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="NovaLink.Lumen.Views.Pages.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <Grid x:Name="LibraryRoot" Margin="4,78,4,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,14">
            <StackPanel Spacing="5">
                <TextBlock Text="LIBRARY" Style="{StaticResource TextEyebrow}" />
                <TextBlock Text="库" Style="{StaticResource TextPageTitle}" />
                <TextBlock Text="管理实例里的模组、世界、资源包与光影。" Style="{StaticResource TextBody}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                <Button x:Name="ImportButton" AutomationProperties.AutomationId="LibraryImport" Style="{StaticResource GhostButton}" Click="Import_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8B5;" FontSize="14" />
                        <TextBlock Text="导入文件" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button x:Name="CheckUpdatesButton" AutomationProperties.AutomationId="LibraryCheckUpdates" Style="{StaticResource GhostButton}" Click="CheckUpdates_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE895;" FontSize="14" />
                        <TextBlock Text="检查更新" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button x:Name="RefreshButton" AutomationProperties.AutomationId="LibraryRefresh" Style="{StaticResource GhostButton}" Click="Refresh_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                        <TextBlock Text="刷新" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button x:Name="OpenFolderButton" AutomationProperties.AutomationId="LibraryOpenFolder" Style="{StaticResource GhostButton}" Click="OpenFolder_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                        <TextBlock Text="打开目录" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <!-- 与发现页的内容类型栏同一种「轨道 + 胶囊」：轨道只画一层底，不再套第二层输入框边框。
                     以前这里是「玻璃外框里再嵌一个带边框的 ComboBox」，两层圆角边框同时可见，
                     看起来就像一层从另一层里穿过去。 -->
                <Border Background="{StaticResource BrushFillSubtle}" BorderBrush="{StaticResource BrushBorderSubtle}"
                        BorderThickness="1" CornerRadius="22" Padding="6,0,6,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE7C3;" FontSize="13" Margin="8,0,0,0" Foreground="{StaticResource BrushTextTertiary}" />
                        <TextBlock Text="当前实例" Style="{StaticResource TextSmall}" VerticalAlignment="Center" />
                        <ComboBox x:Name="InstanceCombo" Width="280" Height="34" AutomationProperties.AutomationId="LibraryInstanceCombo"
                                  Foreground="{StaticResource BrushText}" Background="Transparent" BorderThickness="0"
                                  SelectionChanged="Instance_Changed">
                            <ComboBox.Resources>
                                <SolidColorBrush x:Key="ComboBoxBackground" Color="Transparent" />
                                <SolidColorBrush x:Key="ComboBoxBackgroundUnfocused" Color="Transparent" />
                                <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="Transparent" />
                                <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="Transparent" />
                                <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="Transparent" />
                                <SolidColorBrush x:Key="ComboBoxBorderBrushUnfocused" Color="Transparent" />
                                <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="Transparent" />
                                <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="Transparent" />
                            </ComboBox.Resources>
                        </ComboBox>
                    </StackPanel>
                </Border>
                <!-- 外层 Grid 只是给药丸指示器一个可以绝对定位的宿主：SegmentedSwitch 会把 indicator 加在 Grid 里，
                     而不是塞进 StackPanel（那样会占掉布局位、把按钮挤歪）。 -->
                <Grid x:Name="TabBarHost" VerticalAlignment="Center">
                    <Border Background="{StaticResource BrushFillSubtle}" BorderBrush="{StaticResource BrushBorderSubtle}"
                            BorderThickness="1" CornerRadius="22" IsHitTestVisible="False" />
                    <StackPanel x:Name="TabBar" Orientation="Horizontal" Spacing="4" Padding="4" VerticalAlignment="Center">
                        <Button x:Name="TabMods" Tag="mod" AutomationProperties.AutomationId="LibraryTabMods" Style="{StaticResource GhostButton}" Height="34" Padding="14,0" Click="Tab_Click" Content="模组" />
                        <Button x:Name="TabWorlds" Tag="world" AutomationProperties.AutomationId="LibraryTabWorlds" Style="{StaticResource GhostButton}" Height="34" Padding="14,0" Click="Tab_Click" Content="世界" />
                        <Button x:Name="TabResources" Tag="resourcepack" AutomationProperties.AutomationId="LibraryTabResources" Style="{StaticResource GhostButton}" Height="34" Padding="14,0" Click="Tab_Click" Content="资源包" />
                        <Button x:Name="TabShaders" Tag="shader" AutomationProperties.AutomationId="LibraryTabShaders" Style="{StaticResource GhostButton}" Height="34" Padding="14,0" Click="Tab_Click" Content="光影" />
                    </StackPanel>
                </Grid>
            </StackPanel>
            <TextBlock x:Name="CountText" Style="{StaticResource TextSmall}" HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource GlassCard}" Tag="no-motion" Padding="16,8,16,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="8,8,8,8">
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <TextBlock x:Name="ListTitle" Text="模组" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock x:Name="OverviewText" Style="{StaticResource TextSmall}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Name="PathText" Style="{StaticResource TextSmall}" HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="520" />
                </Grid>

                <Grid Grid.Row="1" Margin="8,0,8,10" x:Name="BulkBar">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <CheckBox x:Name="SelectAllCheck" AutomationProperties.AutomationId="LibrarySelectAll" Checked="SelectAll_Changed" Unchecked="SelectAll_Changed" MinWidth="0" />
                        <TextBlock x:Name="SelectionText" Text="全选" Style="{StaticResource TextSmall}" VerticalAlignment="Center" MinWidth="88" />
                        <Button x:Name="BatchEnableButton" Style="{StaticResource GhostButton}" Height="32" Padding="12,0" Content="批量启用" Click="BatchEnable_Click" />
                        <Button x:Name="BatchDisableButton" Style="{StaticResource GhostButton}" Height="32" Padding="12,0" Content="批量禁用" Click="BatchDisable_Click" />
                        <Button x:Name="BatchUpdateButton" Style="{StaticResource GhostButton}" Height="32" Padding="12,0" Content="更新选中" Click="BatchUpdate_Click" />
                        <Button x:Name="BatchDeleteButton" Style="{StaticResource GhostButton}" Height="32" Padding="12,0" Content="删除选中" Click="BatchDelete_Click" />
                    </StackPanel>
                </Grid>

                <ScrollViewer Grid.Row="2" Style="{StaticResource PageScroll}">
                    <StackPanel x:Name="ItemList" Spacing="8" />
                </ScrollViewer>
                <StackPanel x:Name="EmptyPanel" Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" Visibility="Collapsed">
                    <FontIcon Glyph="&#xE7B8;" FontSize="28" Foreground="{StaticResource BrushTextTertiary}" />
                    <TextBlock x:Name="EmptyText" Text="这里还是空的" FontSize="15" Foreground="{StaticResource BrushTextSecondary}" />
                    <TextBlock Text="从发现页安装内容，或把文件放进对应目录后刷新。" Style="{StaticResource TextSmall}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 加载动画层：盖在内容区上，数据准备好后隐藏 -->
        <Grid x:Name="LoadingHost" Grid.Row="2" />
    </Grid>
</Page>
