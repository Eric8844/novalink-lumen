<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="NovaLink.Lumen.Views.Pages.VersionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <Grid x:Name="PageRoot" Margin="4,78,4,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,18">
            <StackPanel Spacing="5">
                <TextBlock Text="VERSION INSTANCES" Style="{StaticResource TextEyebrow}" />
                <TextBlock Text="版本实例" Style="{StaticResource TextPageTitle}" />
                <TextBlock Text="管理已安装的 Minecraft 实例、加载器与整合包。" Style="{StaticResource TextBody}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                <Button x:Name="RefreshButton" Style="{StaticResource GhostButton}" Click="Refresh_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                        <TextBlock Text="刷新" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button x:Name="ImportButton" AutomationProperties.AutomationId="ImportModpackButton" Style="{StaticResource GhostButton}" Click="Import_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8B5;" FontSize="14" />
                        <TextBlock Text="导入整合包" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button x:Name="LoaderButton" Style="{StaticResource GhostButton}" Click="Loader_Click" ToolTipService.ToolTip="安装 Fabric / Quilt / Forge / NeoForge 加载器">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE74C;" FontSize="14" />
                        <TextBlock Text="加载器" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button x:Name="InstallButton" Style="{StaticResource AccentButton}" Click="Install_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE710;" FontSize="14" />
                        <TextBlock Text="安装新版本" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="356" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource GlassCard}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="8,4,8,12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="已安装" FontSize="13" FontWeight="SemiBold" />
                            <Border Style="{StaticResource Pill}" Padding="8,2" Background="{StaticResource BrushFillSubtle}">
                                <TextBlock x:Name="CountText" Text="0" FontSize="10" Foreground="{StaticResource BrushTextSecondary}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="按最近启动排序" Style="{StaticResource TextSmall}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0">
                        <StackPanel x:Name="VersionList" Spacing="8" />
                    </ScrollViewer>
                    <Rectangle Grid.RowSpan="2" Height="1.5" RadiusX="23" RadiusY="23" Margin="1,0,1,0"
                               VerticalAlignment="Top" HorizontalAlignment="Stretch"
                               Fill="{StaticResource BrushGlassHighlight}" IsHitTestVisible="False" />
                </Grid>
            </Border>

            <Grid Grid.Column="1">
                <Border x:Name="EmptyCard" Style="{StaticResource GlassCard}" Visibility="Collapsed">
                    <Grid>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                            <FontIcon Glyph="&#xE7C3;" FontSize="28" Foreground="{StaticResource BrushTextTertiary}" />
                            <TextBlock Text="还没有安装任何版本" FontSize="15" Foreground="{StaticResource BrushTextSecondary}" />
                            <TextBlock Text="安装 Minecraft 或导入整合包后，实例会出现在这里。" Style="{StaticResource TextSmall}" />
                        </StackPanel>
                        <Rectangle Height="1.5" RadiusX="23" RadiusY="23" Margin="1,0,1,0"
                                   VerticalAlignment="Top" HorizontalAlignment="Stretch"
                                   Fill="{StaticResource BrushGlassHighlight}" IsHitTestVisible="False" />
                    </Grid>
                </Border>

                <ScrollViewer x:Name="DetailScroll" Style="{StaticResource PageScroll}">
                    <StackPanel x:Name="DetailPanel" Spacing="14">
                        <Border Style="{StaticResource GlassCard}" Padding="24,22,24,22">
                            <Grid>
                                <StackPanel Spacing="16">
                                <Grid RowSpacing="12">
                                <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border Style="{StaticResource Pill}" Padding="9,3" Background="{StaticResource BrushSelected}" BorderBrush="{StaticResource BrushNavSelectedBorder}">
                                <TextBlock x:Name="DetailLoaderBadge" Text="FABRIC" FontSize="9" FontWeight="SemiBold"
                                CharacterSpacing="100" Foreground="{StaticResource BrushMint}" />
                                </Border>
                                <Border Style="{StaticResource Pill}" Padding="9,3">
                                <TextBlock x:Name="DetailKernelBadge" Text="内核 1.21.1" FontSize="9" FontWeight="SemiBold"
                                CharacterSpacing="80" Foreground="{StaticResource BrushTextSecondary}" />
                                </Border>
                                </StackPanel>
                                <TextBlock x:Name="DetailName" Text="—" FontSize="34" FontWeight="SemiBold"
                                CharacterSpacing="-18" Margin="0,2,0,0" IsTextSelectionEnabled="True"
                                TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" HorizontalAlignment="Stretch" />
                                <TextBlock x:Name="DetailSub" Text="实例 READY" Style="{StaticResource TextBody}" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Style="{StaticResource GhostButton}" Height="34" Padding="10,0" FontSize="12" Click="OpenFolder_Click">
                                <TextBlock Text="打开目录" VerticalAlignment="Center" />
                                </Button>
                                <Button Style="{StaticResource GhostButton}" Height="34" Padding="10,0" FontSize="12" Click="Rename_Click">
                                <TextBlock Text="重命名" VerticalAlignment="Center" />
                                </Button>
                                <Button Style="{StaticResource GhostButton}" Height="34" Padding="10,0" FontSize="12" Click="Icon_Click">
                                <TextBlock Text="更换图标" VerticalAlignment="Center" />
                                </Button>
                                <Button Style="{StaticResource GhostButton}" Height="34" Padding="10,0" FontSize="12" Click="Delete_Click" AutomationProperties.AutomationId="DeleteInstanceButton">
                                <TextBlock Text="删除" VerticalAlignment="Center" Foreground="{StaticResource BrushDanger}" />
                                </Button>
                                </StackPanel>
                                </Grid>

                                <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource Pill}" Padding="12,10" CornerRadius="14">
                                <StackPanel Spacing="3">
                                <TextBlock Text="模组" Style="{StaticResource TextSmall}" />
                                <TextBlock x:Name="DetailMods" Text="0" FontSize="17" FontWeight="SemiBold" />
                                </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource Pill}" Padding="12,10" CornerRadius="14">
                                <StackPanel Spacing="3">
                                <TextBlock Text="世界" Style="{StaticResource TextSmall}" />
                                <TextBlock x:Name="DetailWorlds" Text="0" FontSize="17" FontWeight="SemiBold" />
                                </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource Pill}" Padding="12,10" CornerRadius="14">
                                <StackPanel Spacing="3">
                                <TextBlock Text="内存" Style="{StaticResource TextSmall}" />
                                <TextBlock x:Name="DetailMemory" Text="4096 MB" FontSize="17" FontWeight="SemiBold" />
                                </StackPanel>
                                </Border>
                                <Border Grid.Column="3" Style="{StaticResource Pill}" Padding="12,10" CornerRadius="14">
                                <StackPanel Spacing="3">
                                <TextBlock Text="Java" Style="{StaticResource TextSmall}" />
                                <TextBlock x:Name="DetailJava" Text="自动" FontSize="17" FontWeight="SemiBold" />
                                </StackPanel>
                                </Border>
                                </Grid>

                                <Button x:Name="PlayButton" Style="{StaticResource AccentButton}" Height="50" HorizontalAlignment="Stretch" Click="Play_Click">
                                <StackPanel Orientation="Horizontal" Spacing="9">
                                <FontIcon x:Name="PlayIcon" Glyph="&#xE768;" FontSize="15" />
                                <TextBlock x:Name="PlayLabel" Text="开始游戏" FontSize="15" VerticalAlignment="Center" />
                                </StackPanel>
                                </Button>
                                </StackPanel>
                                <Rectangle Height="1.5" RadiusX="23" RadiusY="23" Margin="1,0,1,0"
                                           VerticalAlignment="Top" HorizontalAlignment="Stretch"
                                           Fill="{StaticResource BrushGlassHighlight}" IsHitTestVisible="False" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource GlassCard}" Padding="24,20,24,20">
                            <Grid>
                                <StackPanel Spacing="14">
                                <TextBlock Text="实例信息" Style="{StaticResource TextSectionTitle}" />
                                <Grid ColumnSpacing="16" RowSpacing="12">
                                <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="1.6*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="数据目录" Style="{StaticResource TextSmall}" />
                                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="InfoPath" Text="—" FontSize="12" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="加载器" Style="{StaticResource TextSmall}" />
                                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="InfoLoader" Text="—" FontSize="12" />
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="最后启动" Style="{StaticResource TextSmall}" />
                                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="InfoLast" Text="—" FontSize="12" />
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="实例类型" Style="{StaticResource TextSmall}" />
                                <TextBlock Grid.Row="3" Grid.Column="1" x:Name="InfoKind" Text="—" FontSize="12" />
                                </Grid>
                                </StackPanel>
                                <Rectangle Height="1.5" RadiusX="23" RadiusY="23" Margin="1,0,1,0"
                                           VerticalAlignment="Top" HorizontalAlignment="Stretch"
                                           Fill="{StaticResource BrushGlassHighlight}" IsHitTestVisible="False" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Page>