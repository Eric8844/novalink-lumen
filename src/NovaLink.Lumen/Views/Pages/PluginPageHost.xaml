<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="NovaLink.Lumen.Views.Pages.PluginPageHost"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <Grid Margin="4,78,4,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,14">
            <StackPanel Spacing="5">
                <TextBlock Text="PLUGIN" Style="{StaticResource TextEyebrow}" />
                <TextBlock x:Name="PluginTitle" Text="插件" Style="{StaticResource TextPageTitle}" />
                <TextBlock x:Name="PluginCaption" Text="由插件提供的页面。" Style="{StaticResource TextBody}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                <Button x:Name="ReloadButton" AutomationProperties.AutomationId="PluginReload" Style="{StaticResource GhostButton}" Click="Reload_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                        <TextBlock Text="重新加载" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <ContentPresenter x:Name="HostContent" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />

            <StackPanel x:Name="FallbackPanel" Visibility="Collapsed" Spacing="14" MaxWidth="460"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE7BA;" FontSize="34" HorizontalAlignment="Center"
                          Foreground="{StaticResource BrushTextTertiary}" />
                <TextBlock x:Name="FallbackTitle" Text="插件页面暂时打不开" Style="{StaticResource TextPageTitle}"
                           TextAlignment="Center" />
                <TextBlock x:Name="FallbackMessage" Style="{StaticResource TextBody}" TextAlignment="Center"
                           TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" Margin="0,4,0,0">
                    <Button x:Name="RetryButton" AutomationProperties.AutomationId="PluginPageRetry" Style="{StaticResource GhostButton}" Click="Retry_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE72C;" FontSize="14" />
                            <TextBlock Text="重试" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="HomeButton" AutomationProperties.AutomationId="PluginPageHome" Style="{StaticResource GhostButton}" Click="Home_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE80F;" FontSize="14" />
                            <TextBlock Text="返回首页" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
