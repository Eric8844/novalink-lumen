<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="NovaLink.Lumen.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="ms-appx:///Styles/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="ContentDialogBackground" Color="#F70B1220" />
                    <SolidColorBrush x:Key="ContentDialogForeground" Color="#FFF3F7FE" />
                    <SolidColorBrush x:Key="ContentDialogBorderBrush" Color="#33FFFFFF" />
                    <SolidColorBrush x:Key="ContentDialogSeparatorBorderBrush" Color="#1FFFFFFF" />
                    <SolidColorBrush x:Key="ContentDialogTopOverlay" Color="Transparent" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="ContentDialogBackground" Color="#F70B1220" />
                    <SolidColorBrush x:Key="ContentDialogForeground" Color="#FFF3F7FE" />
                    <SolidColorBrush x:Key="ContentDialogBorderBrush" Color="#33FFFFFF" />
                    <SolidColorBrush x:Key="ContentDialogSeparatorBorderBrush" Color="#1FFFFFFF" />
                    <SolidColorBrush x:Key="ContentDialogTopOverlay" Color="Transparent" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="ContentDialogBackground" Color="#F70B1220" />
                    <SolidColorBrush x:Key="ContentDialogForeground" Color="#FFF3F7FE" />
                    <SolidColorBrush x:Key="ContentDialogBorderBrush" Color="#33FFFFFF" />
                    <SolidColorBrush x:Key="ContentDialogSeparatorBorderBrush" Color="#1FFFFFFF" />
                    <SolidColorBrush x:Key="ContentDialogTopOverlay" Color="Transparent" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
